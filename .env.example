# =============================================================================
# Retail Stock Take — local kind stack
# Copy this file to .env to override defaults:  cp .env.example .env
# .env is gitignored and OPTIONAL — the stack needs NO credentials.
#
# The MongoDB control plane (Ops Manager) is self-hosted inside the kind cluster,
# so there is nothing to sign up for and no API keys to paste. setup.sh generates
# all passwords and keys for you. Everything below is just an optional override.
# =============================================================================

# -----------------------------------------------------------------------------
# Optional overrides (defaults shown)
# Uncomment and change only if you need to deviate from the defaults.
# -----------------------------------------------------------------------------

# kind cluster name (default: retail-stock-take)
# KIND_CLUSTER=retail-stock-take

# MCK operator Helm chart version (default: 1.8.1)
# MCK_VERSION=1.8.1

# mongodb/web-app chart version for the app releases (default: 4.30.0)
# WEBAPP_CHART_VERSION=4.30.0

# ── Computer vision provider ────────────────────────────────────────────────
# CV_PROVIDER selects the vision backend: "ollama" (local, default) or "grove"
# (cloud — MongoDB's GenAI gateway). Both share the same capture contract.
# CV_PROVIDER=ollama

# Ollama (local): models pulled into the in-cluster Ollama pod.
# OLLAMA_MODEL=
# OLLAMA_FALLBACK_MODEL=

# Grove (cloud): OpenAI-compatible + vision. Request a service (tier-2) key at
# grove.aix.prod.corp.mongodb.com/requests; base URL + model come from the
# request's Usage section. Defaults below are the current best; override freely.
# GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
# GROVE_MODEL=gpt-5.5
# GROVE_FALLBACK_MODEL=gpt-4o
# GROVE_API_KEY=your-grove-api-key-here

# ── Object storage / photo store ────────────────────────────────────────────
# STORAGE_PROVIDER: "s3" (local SeaweedFS / cloud AWS, default) or "none" to
# disable the photo store entirely (capture keeps inventory metadata only).
# STORAGE_PROVIDER=s3
