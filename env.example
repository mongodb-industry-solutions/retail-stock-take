# =============================================================================
# Retail Stock Take — local kind stack
# Copy this file to .env to override defaults:  cp env.example .env
# .env is gitignored and OPTIONAL — the stack needs NO credentials.
#
# The MongoDB control plane (Ops Manager) is self-hosted inside the kind cluster,
# so there is nothing to sign up for and no API keys to paste. setup.sh generates
# all passwords and keys for you. Everything below is just an optional override.
# =============================================================================

# -----------------------------------------------------------------------------
# Optional overrides (defaults shown)
# Uncomment and change only if you need to deviate from the defaults.
# -----------------------------------------------------------------------------

# kind cluster name (default: retail-stock-take)
# KIND_CLUSTER=retail-stock-take

# MCK operator Helm chart version (default: 1.8.1)
# MCK_VERSION=1.8.1

# mongodb/web-app chart version for the app releases (default: 4.30.0)
# WEBAPP_CHART_VERSION=4.30.0

# Ollama models (default: Qwen2.5-VL 7B + Moondream 2 fallback)
# OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_FALLBACK_MODEL=moondream
