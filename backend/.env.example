# =============================================================================
# retail-stock-take BACKEND runtime environment (example)
# Copy to backend/.env — the backend loads it via python-dotenv (backend cwd).
# This is the ONLY env the backend needs; the frontend uses no env files.
# Local (kind) uses infra/local/ Helm values; this is for running the backend
# directly (uv run uvicorn main:app) or documenting the cloud/Kanopy deploy.
# =============================================================================

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Required. Atlas SRV string in cloud; mongodb://… in local (in-cluster "mongo").
MONGODB_URI=mongodb+srv://app:<password>@<atlas-cluster>/?retryWrites=true
DATABASE_NAME=retail-stock-take
# OPTIONAL: APP_NAME=retail-stock-take-backend
# OPTIONAL: APP_COLLECTION=inventory_captures
# OPTIONAL: MAX_UPLOAD_BYTES=10485760

# ── Object storage (photo store) ─────────────────────────────────────────────
# "s3" (default) or "none". Cloud AWS S3 via IRSA: omit endpoint/keys + set region
# + bucket; the adapter uses boto3's default credential chain (IRSA).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=industry-solutions-demos
STORAGE_REGION=us-east-1
# Local SeaweedFS (unset for cloud/AWS):
# STORAGE_ENDPOINT=http://localhost:8333
# STORAGE_ACCESS_KEY=retaildemo
# STORAGE_SECRET_KEY=retaildemo-secret
# STORAGE_FORCE_PATH_STYLE=true
# Object-key prefix for uploads (sibling of sample-shelves/):
STORAGE_UPLOAD_PREFIX=industry/mobile/retail-stock-take/uploads/
# Curated sample-shelf prefix served by GET /api/sample-shelves (empty = disabled):
STORAGE_SAMPLES_PREFIX=industry/mobile/retail-stock-take/sample-shelves/

# ── Retention (reconciler) ───────────────────────────────────────────────────
RETENTION_DAYS=90
# OPTIONAL: RETENTION_CLASS=standard
# OPTIONAL: RECONCILER_INTERVAL_SECONDS=300
# OPTIONAL: RECONCILER_PENDING_GRACE_SECONDS=900

# ── Computer vision (CV_PROVIDER: "ollama" | "grove") ────────────────────────
CV_PROVIDER=grove
# Grove (cloud, MongoDB GenAI gateway — OpenAI-compatible + vision):
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
GROVE_MODEL=gpt-5.5
GROVE_FALLBACK_MODEL=gpt-4o
GROVE_API_KEY=your-grove-api-key-here
# Ollama (local, in-cluster) — used when CV_PROVIDER=ollama:
# OLLAMA_MODEL=moondream
# OLLAMA_FALLBACK_MODEL=

# ── Auth (RS256 JWT + JWKS) ──────────────────────────────────────────────────
# Required: PEM paths to the RSA keypair used to sign/verify tokens.
JWT_PRIVATE_KEY_PATH=/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
# OPTIONAL: JWT_KID=retail-key-1
# OPTIONAL: JWT_ALGORITHM=RS256
# OPTIONAL: JWT_TTL_SECONDS=3600
# PowerSync must trust the same aud/iss:
PS_JWT_AUDIENCE=powersync
PS_JWT_ISSUER=retail-stock-take

# ── PowerSync URLs ───────────────────────────────────────────────────────────
POWERSYNC_PUBLIC_URL=https://retail-stock-take-powersync.industrysolutions.prod.corp.mongodb.com
POWERSYNC_INTERNAL_URL=http://retail-stock-take-powersync-web-app-80
